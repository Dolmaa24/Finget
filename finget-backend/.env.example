# Copy to .env and fill in. Never commit the real .env.

# NOT 5000: macOS binds that port to the AirPlay Receiver by default, so the
# server appears to start and then every request 403s from a service that is
# not ours. Disable it under System Settings > General > AirDrop & Handoff if
# you really want 5000 back.
PORT=5001

# Local: mongodb://localhost:27017/finget
# Atlas: mongodb+srv://<user>:<password>@<cluster>/finget?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/finget

# Use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=replace_with_a_long_random_secret

# AI provider (optional). Without one, the AI coach and AI insights run in a
# clearly-labelled degraded mode; every other feature works normally.
#
# Groq is preferred and uses an OpenAI-compatible endpoint.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Alternatively, OpenAI. Only used when GROQ_API_KEY is empty.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Comma-separated origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Where the web app lives. Public share pages link back here.
APP_BASE_URL=http://localhost:5173
# Where this API lives. Used to build absolute share-card and OG image URLs.
API_BASE_URL=http://localhost:5001

# How long a public share card stays readable before its TTL index removes it.
SHARE_CARD_TTL_DAYS=90

# How long a browser-extension token stays valid. It is revocable from Settings
# at any time; this is the backstop for one that is simply forgotten.
API_TOKEN_TTL_DAYS=365

# --- Screenshot import (optional) --------------------------------------
# Reading payment screenshots needs a VISION model. Groq has none on its
# current lineup — its text models reject image content outright — so this is
# a separate, pluggable provider. Leave it unset and screenshot import is
# cleanly disabled; pasting bank SMS still works with no key at all.
#
#   VISION_PROVIDER   openai | anthropic | openai-compatible
#   VISION_API_KEY    falls back to OPENAI_API_KEY / ANTHROPIC_API_KEY
#   VISION_MODEL      default: gpt-4o-mini (openai) / claude-sonnet-4-5
#   VISION_BASE_URL   for any OpenAI-compatible host, incl. Groq if it ships one
# VISION_PROVIDER=openai
# VISION_API_KEY=
# VISION_MODEL=gpt-4o-mini

# --- Email, for the Silent Collector (optional) -------------------------
# Settle-up reminders are delivered in-app ALWAYS, and by email only when both
# of these are set. Leave them blank and reminders still appear in the app,
# still escalate on the same schedule, and still carry their UPI pay link —
# only the inbox copy is skipped. Nothing else changes.
#
# Get a key at https://resend.com/api-keys. MAIL_FROM must be an address on a
# domain you have verified there, e.g. finget@yourdomain.com.
RESEND_API_KEY=
MAIL_FROM=

# Entitlement gates. Every capability check is wired but returns true while
# this is false; Milestone 8 flips it on alongside the Razorpay integration.
PAYWALL_ENABLED=false

# --- Testing -----------------------------------------------------------
# Point the test suite at a real Mongo and skip mongodb-memory-server's
# ~170 MB binary download entirely. Useful in CI and on locked-down networks.
# MONGO_TEST_URI=mongodb://localhost:27017/finget_test
#
# Otherwise, cache that binary once per machine instead of once per clone:
# MONGOMS_DOWNLOAD_DIR=~/.cache/mongodb-binaries
