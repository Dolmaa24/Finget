{
  "manifest_version": 3,
  "name": "Finget — price things in your own goals",
  "version": "0.1.0",
  "description": "Shows what a purchase actually costs you — in days of the trip you're saving for — right on the product page.",
  "minimum_chrome_version": "102",

  "action": {
    "default_popup": "popup.html",
    "default_title": "Finget"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "permissions": ["storage"],

  "host_permissions": [
    "http://localhost:5000/*",
    "https://localhost:5000/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.in/*",
        "https://amazon.in/*",
        "https://www.flipkart.com/*",
        "https://www.myntra.com/*",
        "https://www.nykaa.com/*",
        "https://www.zomato.com/*",
        "https://www.swiggy.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "js": ["connect.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
